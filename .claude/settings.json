{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(glualint *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(./tools/*)",
      "WebFetch(domain:wiki.facepunch.com)"
    ],
    "deny": [
      "Bash(fastgmad publish *)",
      "Bash(fastgmad update *)",
      "Read(**/config.vdf)",
      "Read(**/ssfn*)",
      "Read(./build/**)",
      "Read(./.dev/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-lua.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/trim-logs.sh" }]
      }
    ]
  }
}
